        huggingface "Hugging Face Spaces browser (hf CLI)" \
        deeptutor   "DeepTutor personalized learning web app" \
        nanobot     "nanobot personal AI assistant (WebUI)" \
        agent-reach "Agent Reach internet access for agents" \
        dsh         "DeepSeek Harness assistant + coding harness" \
        openclaw    "OpenClaw CLI" \
        fabric      "Fabric AI patterns CLI" \
        sgpt        "ShellGPT shell assistant" \
        gptme       "gptme terminal agent" \
        llm         "LLM CLI by Simon Willison"
}

case "${1:-}" in
    ""|help|-h|--help)
        usage ;;
    harness)
        agent="${2:-}"
        shift 2 2>/dev/null || true
        harness_provider=""
        harness_model=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --provider) harness_provider="${2:-}"; shift 2 ;;
                --model) harness_model="${2:-}"; shift 2 ;;
                *) shift ;;
            esac
        done
        [ -n "$harness_provider" ] && export G4F_PROVIDER="$harness_provider"
        [ -n "$harness_model" ] && export G4F_MODEL="$harness_model"
        if [ -n "$agent" ]; then
            settings_file="${G4F_SANDBOX_ENV:-$HOME/.config/g4f-sandbox/env}"
            mkdir -p "$(dirname "$settings_file")"
            key="HARNESS_$(printf '%s' "$agent" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_')"
            tmp="${settings_file}.tmp.$$"
            ( [ -f "$settings_file" ] && grep -v "^${key}=" "$settings_file" || true
              [ -n "$harness_provider$harness_model" ] && printf '%s=%s:%s\n' "$key" "$harness_provider" "$harness_model" ) > "$tmp"
            mv "$tmp" "$settings_file"
        fi
        exec "$0" "$agent" ;;
    list)
        list_tools ;;
    urls)
        public_urls
        hold_open ;;
    hosts)
        print_hosts
        hold_open ;;
    configure)
        shift
        run_configure "$@" ;;
    settings)
        shift
        run_settings "$@" ;;    reset)
        shift
        run_reset "$@" ;;
    package)
        shift
        run_package "$@" ;;
    install)
        [ $# -ge 2 ] || die "usage: sandbox-cli install <tool>"
        INSTALL_ONLY=1
        run_tool "$2" ;;
    *)
        tool="$1"
        shift
        run_tool "$tool" "$@" ;;
esac
