INSTALL_ONLY=0

have() { command -v "$1" >/dev/null 2>&1; }
log()  { printf '==> %s\n' "$*"; }

# True when something accepts connections on 127.0.0.1:<port>.
port_open() {
    if have curl; then
        curl -s --max-time 1 "http://127.0.0.1:$1/json/version" >/dev/null 2>&1
    else
        (exec 3<>"/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1
    fi
}

# Menu entries open a fresh terminal that closes on exit; hold it so the
# output of a one-shot command stays readable.
hold_open() {
    [ -t 0 ] || return 0
    printf '\nPress Enter to close...'
    read -r _ || true
}

die() {
    printf '\nsandbox-cli: error: %s\n' "$*" >&2
    hold_open
    exit 1
}

# Menu installs run as `pn`, which has passwordless sudo in the image.
as_root() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    else
        sudo -n "$@" || die "need root privileges for: $*"
    fi
}

# True when something accepts a TCP connection on 127.0.0.1:<port>. Unlike
# port_open this makes no HTTP request, so it also works for non-HTTP services
# such as the bundled MongoDB.
tcp_open() {
    (exec 3<>"/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1
}

# Set KEY=value in an env-style file: replace the line when the key is already
# there (commented out or not), append it otherwise.
set_env_var() { # <file> <key> <value>
    local file="$1" key="$2" value="$3" tmp
    tmp="$(mktemp)" || die "could not create a temporary file"
    if grep -qE "^[[:space:]]*#?[[:space:]]*${key}=" "$file"; then
        sed -E "0,/^[[:space:]]*#?[[:space:]]*${key}=/s|^[[:space:]]*#?[[:space:]]*${key}=.*|${key}=${value}|" \
            "$file" >"$tmp" || die "could not update $key in $file"
    else
        cat "$file" >"$tmp"
        printf '%s=%s\n' "$key" "$value" >>"$tmp"
    fi
    mv "$tmp" "$file" || die "could not write $file"
}

# ---------------------------------------------------------------------------
# Sandbox settings (g4f model, API key, g4f provider + HOME)
#
# A desktop menu entry cannot export environment variables, so the launchers
# read their overrides from a small settings file that the "Sandbox Settings"
# menu entry writes. The file deliberately lives outside $HOME: changing HOME
# must not move the file that records it.
#
# Precedence, highest first:
#   G4F_SANDBOX_MODEL / G4F_SANDBOX_API_KEY / G4F_SANDBOX_HOME /
#   G4F_SANDBOX_PROVIDER / G4F_SANDBOX_PROXY
#                                          explicit environment override
#   the settings file                      what the menu entry saved
#   G4F_MODEL / G4F_API_KEY / $HOME / G4F_PROVIDER / G4F_PROXY
#                                          ambient environment, then defaults
#
# API KEY is exported as G4F_API_KEY for the g4f-aware launchers and for the
# API server the tray starts, so a key saved here authenticates both sides.
#
# HOME applies to every menu entry (see apply_sandbox_home): agents keep their
# config, credentials and caches under $HOME, so pointing it at a scratch
# directory gives a throwaway profile.
#
# PROXY applies to every menu entry too (see apply_sandbox_proxy): it is
# exported as G4F_PROXY (read by g4f itself) and as the conventional
# HTTP_PROXY/HTTPS_PROXY/ALL_PROXY variables (read by the agents and the tools
# they shell out to). It typically points at the local "Install & Run Proxy
# Server" entry (mitmproxy on 127.0.0.1:8081); loopback stays direct. The
# proxy's CA is trusted at the same time (see trust_proxy_ca), and OpenCode's
# background server is told about both (see configure_opencode_service).
#
# The g4f-aware launchers always register a g4f provider that offers the
# "auto" model, so the API is reachable from the tool's model picker even
# before anything is chosen. A model chosen through G4F_SANDBOX_MODEL or the
# settings file is registered and used as the tool's default too; with no model
# chosen, the tool keeps its own default model. The provider is optional: with
# none set, g4f picks from its own rotation. When one is set and a model was
# chosen, the launchers pin it by prefixing the model name
# ("<provider>:<model>"), which is how g4f resolves a provider for a request;
# G4F_PROVIDER itself is read only by the g4f server.
# ---------------------------------------------------------------------------
real_home() {
    local home
    home="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
    [ -n "$home" ] || home="${HOME:-/home/pn}"
    printf '%s' "$home"
}

SANDBOX_ENV_FILE="${G4F_SANDBOX_ENV:-$(real_home)/.config/g4f-sandbox/env}"
# mitmproxy signs the HTTPS traffic it intercepts with its own CA. The CA lives
# in a fixed confdir under the real home (not $HOME): the per-entry HOME
# setting must not move it, or a tool launched with another HOME would not find
# the certificate the proxy is using. The path is also exported to the tools
# (see apply_sandbox_proxy), so a custom location works the same way.
PROXY_CA_DIR="${G4F_SANDBOX_MITM_DIR:-$(real_home)/.config/g4f-sandbox/mitmproxy}"
PROXY_CA_CERT="$PROXY_CA_DIR/mitmproxy-ca-cert.pem"
PROXY_CA_BUNDLE="$PROXY_CA_DIR/ca-bundle.pem"
# The system trust store, used as the base of the bundle the tools are pointed
# at: mitmproxy's CA is appended to it rather than replacing it, so direct
# (NO_PROXY) connections keep working.
SYSTEM_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"
SANDBOX_MODEL=""
SANDBOX_HOME=""
SANDBOX_PROVIDER=""
SANDBOX_PROXY=""
SANDBOX_API_KEY=""
# 1 once a model was chosen (G4F_SANDBOX_MODEL, or the settings file), else 0.
SANDBOX_MODEL_SET=0
# 1 once the settings file contains G4F_API_KEY (even when it is empty), so a
# cleared key suppresses an ambient G4F_API_KEY instead of falling back to it.
SANDBOX_API_KEY_SET=0
# The model every g4f provider registration exposes even when no model was
# chosen: g4f's "auto" lets the server pick a provider and model itself.
G4F_AUTO_MODEL="auto"

load_sandbox_settings() {
    SANDBOX_MODEL=""
    SANDBOX_HOME=""
    SANDBOX_PROVIDER=""
    SANDBOX_PROXY=""
    SANDBOX_API_KEY=""
    SANDBOX_MODEL_SET=0
    SANDBOX_API_KEY_SET=0
    [ -f "$SANDBOX_ENV_FILE" ] || return 0
    local line key value
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        key="${line%%=*}"
        value="${line#*=}"
        case "$key" in
            G4F_MODEL)
                SANDBOX_MODEL="$value"
                [ -n "$value" ] && SANDBOX_MODEL_SET=1 ;;
            SANDBOX_HOME) SANDBOX_HOME="$value" ;;
            G4F_PROVIDER) SANDBOX_PROVIDER="$value" ;;
            SANDBOX_PROXY) SANDBOX_PROXY="$value" ;;
            G4F_API_KEY) SANDBOX_API_KEY="$value"; SANDBOX_API_KEY_SET=1 ;;
        esac
    done < "$SANDBOX_ENV_FILE"
}

save_sandbox_settings() { # <model> <home> <provider> <proxy> <api-key>
    local dir
    dir="$(dirname "$SANDBOX_ENV_FILE")"
    mkdir -p "$dir" || die "cannot create $dir"
    {
        printf '# g4f sandbox settings — written by: sandbox-cli settings\n'
        printf '# Read by the menu launchers (HOME, proxy, API key) and the g4f-aware\n'
        printf '# ones (OpenCode, Copilot, Hermes, LibreChat, assistant-ui).\n'
        printf 'G4F_MODEL=%s\n' "$1"
        printf 'SANDBOX_HOME=%s\n' "$2"
        printf 'G4F_PROVIDER=%s\n' "$3"
        printf 'SANDBOX_PROXY=%s\n' "$4"
        printf 'G4F_API_KEY=%s\n' "$5"
    } > "$SANDBOX_ENV_FILE" || die "cannot write $SANDBOX_ENV_FILE"
    # The file can hold G4F_API_KEY; keep it private to the sandbox user.
    chmod 600 "$SANDBOX_ENV_FILE" 2>/dev/null || true
}

mask_secret() { # <value>
    local len="${#1}"
    if [ "$len" -eq 0 ]; then
        printf '(unset)'
    else
        printf '******** (%s characters)' "$len"
    fi
}

show_sandbox_settings() {
    printf 'settings file: %s\n' "$SANDBOX_ENV_FILE"
    if [ -f "$SANDBOX_ENV_FILE" ]; then
        printf 'G4F_MODEL:     %s\n' "${SANDBOX_MODEL:-(unset)}"
        printf 'G4F_API_KEY:   %s\n' "$(mask_secret "$SANDBOX_API_KEY")"
        printf 'HOME:          %s\n' "${SANDBOX_HOME:-(unset)}"
        printf 'G4F_PROVIDER:  %s\n' "${SANDBOX_PROVIDER:-(unset)}"
        printf 'PROXY:         %s\n' "${SANDBOX_PROXY:-(unset)}"
    else
        printf 'G4F_MODEL:     %s (default)\n' "${G4F_MODEL:-(unset)}"
        printf 'G4F_API_KEY:   %s (default)\n' "$(mask_secret "${G4F_API_KEY:-}")"
        printf 'HOME:          %s (default)\n' "$(real_home)"
        printf 'G4F_PROVIDER:  %s (default)\n' "${G4F_PROVIDER:-(unset)}"
        printf 'PROXY:         %s (default)\n' "${G4F_PROXY:-(unset)}"
    fi
}

validate_sandbox_home() { # <dir>
    case "$1" in
        /*) ;;
        *) die "HOME must be an absolute path: $1" ;;
    esac
    mkdir -p "$1" 2>/dev/null || true
    [ -w "$1" ] && return 0
    # A path outside the user's own tree (e.g. /opt/agent-home) needs root.
    # Create it as root, then hand it to the invoking user so the agents can
    # actually write their config there.
    log "creating $1 as root (needs sudo)..."
    as_root mkdir -p "$1" || die "cannot create HOME directory: $1"
    as_root chown "$(id -u):$(id -g)" "$1" \
        || die "cannot take ownership of HOME directory: $1"
    [ -w "$1" ] || die "HOME directory is not writable: $1"
}

prompt_sandbox_settings() {
    local model home provider proxy api_key answer
    model="${SANDBOX_MODEL:-${G4F_MODEL:-}}"
    home="${SANDBOX_HOME:-$(real_home)}"
    provider="${SANDBOX_PROVIDER:-${G4F_PROVIDER:-}}"
    proxy="${SANDBOX_PROXY:-${G4F_PROXY:-}}"
    api_key="${SANDBOX_API_KEY:-${G4F_API_KEY:-}}"
    printf 'g4f sandbox settings — press Enter to keep the value in brackets.\n\n'
    printf 'Model passed to the g4f API (G4F_MODEL).\n'
    read -r -p "  model [$model]: " answer || true
    [ -n "$answer" ] && model="$answer"
    printf '\nAPI key the server requires and the launchers send (G4F_API_KEY).\n'
    printf 'Enter keeps it; clear it with: sandbox-cli settings --api-key ""\n'
    read -r -s -p "  API key [$([ -n "$api_key" ] && printf set || printf none)]: " answer || true
    printf '\n'
    [ -n "$answer" ] && api_key="$answer"
    printf '\nHOME used by every menu entry (agents keep their config here).\n'
    read -r -p "  HOME [$home]: " answer || true
    [ -n "$answer" ] && home="$answer"
    printf '\ng4f provider the g4f-aware launchers pin (G4F_PROVIDER).\n'
    printf 'It is sent as "<provider>:<model>"; Enter keeps it, clear it with:\n'
    printf '  sandbox-cli settings --provider ""\n'
    read -r -p "  provider [${provider:-none}]: " answer || true
    [ -n "$answer" ] && provider="$answer"
    printf '\nProxy used by every menu entry (HTTP_PROXY/HTTPS_PROXY and G4F_PROXY).\n'
    printf 'Point it at the Proxy Server entry, e.g. http://127.0.0.1:8081.\n'
    printf 'Enter keeps it, clear it with:\n'
    printf '  sandbox-cli settings --proxy ""\n'
    read -r -p "  proxy [${proxy:-none}]: " answer || true
    [ -n "$answer" ] && proxy="$answer"
    printf '\n'
    validate_sandbox_home "$home"
    save_sandbox_settings "$model" "$home" "$provider" "$proxy" "$api_key"
    load_sandbox_settings
    show_sandbox_settings
}

# The full-screen editor lives in a separate stdlib-only Python script so the
# line prompts below stay available on a terminal where curses is unavailable.
sandbox_settings_script() {
    local candidate
    if [ -n "${G4F_SANDBOX_SETTINGS_BIN:-}" ]; then
        [ -f "${G4F_SANDBOX_SETTINGS_BIN}" ] \
            && { printf '%s\n' "${G4F_SANDBOX_SETTINGS_BIN}"; return 0; }
        return 1
    fi
    candidate="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/sandbox-settings"
    if [ -f "$candidate" ]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    candidate="$(command -v sandbox-settings 2>/dev/null || true)"
    [ -n "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
    return 1
}

run_settings_tool() {
    local script
    script="$(sandbox_settings_script)" || return 127
    have python3 || return 127
    python3 "$script" "$@"
}

run_settings_tui() {
    [ -t 0 ] && [ -t 1 ] || return 2
    run_settings_tool
}

prompt_api_key() {
    local key="${SANDBOX_API_KEY:-${G4F_API_KEY:-}}" answer
    [ -t 0 ] || die "sandbox-cli settings --api-key needs a terminal"
    printf 'g4f API key — press Enter to keep the current value.\n\n'
    printf 'The server requires this key and the menu launchers send it (G4F_API_KEY).\n'
    printf 'Clear it with: sandbox-cli settings --api-key ""\n\n'
    read -r -s -p "  API key [$([ -n "$key" ] && printf set || printf none)]: " answer || true
    printf '\n'
    [ -n "$answer" ] && key="$answer"
    save_sandbox_settings \
        "${SANDBOX_MODEL:-${G4F_MODEL:-}}" \
        "${SANDBOX_HOME:-$(real_home)}" \
        "${SANDBOX_PROVIDER:-${G4F_PROVIDER:-}}" \
        "${SANDBOX_PROXY:-${G4F_PROXY:-}}" \
        "$key"
    load_sandbox_settings
    show_sandbox_settings
}

settings_usage() {
    cat <<'EOF'
usage: sandbox-cli settings                    open the interactive settings editor
       sandbox-cli settings --show             print the saved settings
       sandbox-cli settings --json             print saved/effective settings as JSON
       sandbox-cli settings --check            validate the settings file
       sandbox-cli settings --generate-key     print a new random API key (does not save it)
       sandbox-cli settings --restart-server   ask the running tray to restart the API
       sandbox-cli settings --model <id>       set the model (keeps the rest)
       sandbox-cli settings --api-key <key>    set the API key ("" clears it)
       sandbox-cli settings --api-key          prompt for just the API key
       sandbox-cli settings --home <dir>       set HOME (keeps the rest)
       sandbox-cli settings --provider <name>  set the g4f provider
       sandbox-cli settings --proxy <url>      set the HTTP(S) proxy
       sandbox-cli settings --unset            drop the file and use the defaults

The interactive editor validates every value before writing, shows whether a
value comes from the environment, the settings file or the built-in default,
masks the API key (with reveal and generate actions), and asks the tray to
restart the API after saving. Keys: up/down move, Enter edit, s save, t test
the saved connection, r restart the server, R reset, g generate a key,
v reveal, c clear a field, q quit.

HOME and PROXY apply to every menu entry. The g4f-aware launchers (OpenCode,
Copilot, Hermes, LibreChat, assistant-ui) additionally read the model, provider
and API key. The API key is exported as G4F_API_KEY, both to the tools and to
the server the tray starts, so one saved key authenticates both sides. The
environment variables G4F_SANDBOX_MODEL, G4F_SANDBOX_API_KEY,
G4F_SANDBOX_HOME, G4F_SANDBOX_PROVIDER and G4F_SANDBOX_PROXY override the
settings file. PROXY is exported as G4F_PROXY (for g4f) and as
HTTP_PROXY/HTTPS_PROXY/ALL_PROXY (for the agents), with loopback kept direct.
The launchers always register the g4f provider with the "auto" model; a saved
model is also registered and becomes the tool's default, while without one the
tool keeps its own default model. Copilot only applies its BYOK provider when a
model is set.
EOF
}

run_settings() {
    local model="" home="" provider="" proxy="" api_key=""
    local set_model=0 set_home=0 set_provider=0 set_proxy=0 set_api_key=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --show|show)
                show_sandbox_settings
                return 0 ;;
            --json|--check|--generate-key|--restart-server)
                run_settings_tool "$1"
                return $? ;;
            --unset|unset)
                rm -f "$SANDBOX_ENV_FILE" || die "cannot remove $SANDBOX_ENV_FILE"
                log "cleared $SANDBOX_ENV_FILE"
                return 0 ;;
            --model)
                [ $# -ge 2 ] || die "--model needs a value"
                model="$2"; set_model=1; shift 2 ;;
            --home)
                [ $# -ge 2 ] || die "--home needs a value"
                home="$2"; set_home=1; shift 2 ;;
            --provider)
                [ $# -ge 2 ] || die "--provider needs a value"
                provider="$2"; set_provider=1; shift 2 ;;
            --proxy)
                [ $# -ge 2 ] || die "--proxy needs a value"
                proxy="$2"; set_proxy=1; shift 2 ;;
            --api-key)
                if [ $# -lt 2 ]; then
                    prompt_api_key
                    return 0
                fi
                api_key="$2"; set_api_key=1; shift 2 ;;
            -h|--help|help)
                settings_usage
                return 0 ;;
            *)
                die "unknown settings option \"$1\" — run: sandbox-cli settings --help" ;;
        esac
    done
    if [ "$set_model" = 1 ] || [ "$set_home" = 1 ] || [ "$set_provider" = 1 ] \
        || [ "$set_proxy" = 1 ] || [ "$set_api_key" = 1 ]; then
        [ "$set_model" = 1 ] || model="${SANDBOX_MODEL:-${G4F_MODEL:-}}"
        [ "$set_home" = 1 ] || home="${SANDBOX_HOME:-$(real_home)}"
        [ "$set_provider" = 1 ] || provider="${SANDBOX_PROVIDER:-${G4F_PROVIDER:-}}"
        [ "$set_proxy" = 1 ] || proxy="${SANDBOX_PROXY:-${G4F_PROXY:-}}"
        [ "$set_api_key" = 1 ] || api_key="${SANDBOX_API_KEY:-${G4F_API_KEY:-}}"
        validate_sandbox_home "$home"
        save_sandbox_settings "$model" "$home" "$provider" "$proxy" "$api_key"
        load_sandbox_settings
        show_sandbox_settings
        return 0
    fi
    [ -t 0 ] || die "sandbox-cli settings needs a terminal (or use --model/--api-key/--home/--provider/--proxy/--show/--json)"
    run_settings_tui
    local rc=$?
    if [ "$rc" -eq 2 ] || [ "$rc" -eq 127 ]; then
        # No curses editor or no Python: keep the line-based prompt working.
        prompt_sandbox_settings
        return 0
    fi
    return "$rc"
}

reset_usage() {
    cat <<'EOF'
usage: sandbox-cli reset            clear the saved settings (asks first)
       sandbox-cli reset --yes      clear them without asking
       sandbox-cli reset --show     print what would be cleared

Drops the settings file written by "sandbox-cli settings", so the launchers
fall back to the ambient environment and the built-in defaults (G4F_MODEL,
G4F_API_KEY, $HOME, G4F_PROVIDER). Only that file is removed — installed tools,
agent configs and the g4f runtime are left alone.
EOF
}

run_reset() {
    local assume_yes=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --yes|-y|yes)
                assume_yes=1; shift ;;
            --show|show)
                show_sandbox_settings
                return 0 ;;
            -h|--help|help)
                reset_usage
                return 0 ;;
            *)
                die "unknown reset option \"$1\" — run: sandbox-cli reset --help" ;;
        esac
    done
    if [ ! -f "$SANDBOX_ENV_FILE" ]; then
        log "no settings file at $SANDBOX_ENV_FILE — nothing to reset"
        hold_open
        return 0
    fi
    if [ "$assume_yes" = 0 ]; then
        [ -t 0 ] || die "sandbox-cli reset needs a terminal (or use --yes)"
        printf 'This removes %s and restores the default model, API key, HOME and provider.\n' \
            "$SANDBOX_ENV_FILE"
        local answer
        read -r -p "Reset the sandbox settings? [y/N]: " answer || true
        case "$answer" in
            y|Y|yes|YES) ;;
            *) log "kept $SANDBOX_ENV_FILE"; hold_open; return 0 ;;
        esac
    fi
    rm -f "$SANDBOX_ENV_FILE" || die "cannot remove $SANDBOX_ENV_FILE"
    load_sandbox_settings
    log "cleared $SANDBOX_ENV_FILE"
    show_sandbox_settings
    hold_open
}

load_sandbox_settings

# ---------------------------------------------------------------------------
# g4f package management
#
# The sandbox's Python runtime and g4f install are owned by g4f-go. The tray's
# "Update g4f package" and "Change g4f package version" items open this command
# in a terminal; the tray restarts the server when the terminal closes.
# ---------------------------------------------------------------------------
package_show() {
    if have g4f-go; then
        g4f-go --version 2>/dev/null || true
        g4f-go status 2>/dev/null || true
    else
        printf 'g4f-go: not installed\n'
    fi
    if have python3; then
        python3 - <<'PY' 2>/dev/null || true
import importlib.metadata

try:
    print("g4f package:", importlib.metadata.version("g4f"))
except importlib.metadata.PackageNotFoundError:
    print("g4f package: not installed")
PY
    fi
}

package_usage() {
    cat <<'EOF'
usage: sandbox-cli package                 ask for a version (Enter keeps it)
       sandbox-cli package --show          show the running g4f package
       sandbox-cli package --update        install the latest g4f release
       sandbox-cli package --version <v>   install exactly g4f <v>
       sandbox-cli package --version latest
                                           same as --update

The package is managed by g4f-go, which pins an exact version in
~/.g4f/python-embed/.g4f-runtime/.g4f-version. "latest" removes that pin and
tracks new g4f releases again. Restart the server from the tray (or Ctrl-C
and reopen the API) after the install finishes.
EOF
}

run_package() {
    local action="prompt" version=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --show|show)
                package_show
                hold_open
                return 0 ;;
            --update|update)
                action="update"; shift ;;
            --version)
                [ $# -ge 2 ] || die "--version needs a version (or \"latest\")"
                version="$2"; action="version"; shift 2 ;;
            --latest)
                action="update"; shift ;;
            -h|--help|help)
                package_usage
                return 0 ;;
            *)
                die "unknown package option \"$1\" — run: sandbox-cli package --help" ;;
        esac
    done
    have g4f-go || die "g4f-go is not installed"
    if [ "$action" = "prompt" ]; then
        [ -t 0 ] || die "sandbox-cli package needs a terminal (or use --show/--update/--version)"
        package_show
        printf '\n'
        printf 'Enter a g4f version to install (for example 0.5.2), or\n'
        printf '"latest" to track the newest release. Enter keeps the current package.\n'
        read -r -p 'g4f version [keep]: ' version || true
        case "$version" in
            "") log "keeping the current g4f package"; hold_open; return 0 ;;
            latest|LATEST) action="update" ;;
            *) action="version" ;;
        esac
    fi
    if [ "$action" = "update" ] || [ "$version" = "latest" ]; then
        # The saved proxy/HOME also apply to the network install.
        apply_sandbox_home
        apply_sandbox_proxy
        log "installing the latest g4f package..."
        g4f-go install --upgrade g4f || die "g4f package update failed"
    else
        [ -n "$version" ] || die "no g4f version given"
        apply_sandbox_home
        apply_sandbox_proxy
        log "installing g4f $version..."
        g4f-go install "g4f==$version" || die "installing g4f $version failed"
    fi
    log "done; restart the server to load the new package (the tray does this when this window closes)"
    package_show
    hold_open
}

# HOME is a per-menu-entry setting, so it is applied for every tool, not just
# the g4f-aware ones: agents keep their config, credentials and caches under
# $HOME, and a scratch HOME gives a throwaway profile. The PATH entries added
# at the top of this script were derived from the original HOME, so they are
# re-prepended here.
apply_sandbox_home() {
    local home="${G4F_SANDBOX_HOME:-${SANDBOX_HOME:-}}"
    [ -n "$home" ] || return 0
    # A HOME saved before it existed (or created by root) would make every
    # agent fail on its first write, so make sure it is there and ours.
    if [ ! -d "$home" ] || [ ! -w "$home" ]; then
        validate_sandbox_home "$home"
    fi
    export HOME="$home"
    PATH="$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.openclaw/bin:$HOME/.kimi-code/bin:$HOME/.qoder/bin:$PATH"
    export PATH
}

# The API key is shared by both sides of the g4f integration: the server the
# tray starts reads it from the same settings file, and the launchers send it
# as a bearer token. An explicit G4F_SANDBOX_API_KEY wins over the saved value.
apply_sandbox_api_key() {
    if [ -n "${G4F_SANDBOX_API_KEY+x}" ]; then
        if [ -n "$G4F_SANDBOX_API_KEY" ]; then
            export G4F_API_KEY="$G4F_SANDBOX_API_KEY"
        else
            unset G4F_API_KEY
        fi
        return 0
    fi
    if [ "$SANDBOX_API_KEY_SET" = 1 ]; then
        if [ -n "$SANDBOX_API_KEY" ]; then
            export G4F_API_KEY="$SANDBOX_API_KEY"
        else
            unset G4F_API_KEY
        fi
        return 0
    fi
    [ -n "${G4F_API_KEY:-}" ] && export G4F_API_KEY
    return 0
}

# mitmproxy signs the HTTPS traffic it intercepts with its own CA, which no
# tool trusts by default: without it every intercepted HTTPS request fails with
# "unable to verify the first certificate" (OpenCode logs exactly that for its
# update check and for models.opencode.ai). Point the tools at a bundle that
# holds the system CAs plus mitmproxy's, and install the CA into the system
# store so anything that reads it directly (curl, Python, Chrome) works too.
#
# The bundle is rebuilt on every launch: mitmproxy regenerates its CA when the
# confdir is recreated, and a stale bundle would silently break TLS again.
# Every failure here is non-fatal — a proxy that has not run yet simply has no
# CA to trust, and the launcher must still start the tool. as_root is
# deliberately not used: it dies (and waits for Enter) on failure, which would
# turn a missing CA into a launcher that never starts.
trust_proxy_ca() {
    [ -r "$PROXY_CA_CERT" ] || return 0
    local bundle="$PROXY_CA_BUNDLE"
    if ! { cat "$SYSTEM_CA_BUNDLE" 2>/dev/null || :; cat "$PROXY_CA_CERT"; } > "$bundle" 2>/dev/null; then
        log "could not write the proxy CA bundle at $bundle; HTTPS through the proxy may fail"
        return 0
    fi
    export NODE_EXTRA_CA_CERTS="$bundle"
    export SSL_CERT_FILE="$bundle" REQUESTS_CA_BUNDLE="$bundle" CURL_CA_BUNDLE="$bundle"
    export GIT_SSL_CAINFO="$bundle" AWS_CA_BUNDLE="$bundle"
    # The system store is what Chrome and the other GUI apps read. Installing
    # the CA there is idempotent: the anchor is overwritten in place and
    # update-ca-certificates rebuilds the store from the anchors, so repeated
    # launches do not pile up copies. update-ca-certificates lives in /usr/sbin,
    # which is not on the PATH the menu entries run with.
    local anchor="/usr/local/share/ca-certificates/g4f-sandbox-proxy.crt"
    [ -f "$anchor" ] && cmp -s "$PROXY_CA_CERT" "$anchor" && return 0
    if [ "$(id -u)" -eq 0 ]; then
        install -m 0644 "$PROXY_CA_CERT" "$anchor" 2>/dev/null || return 0
        /usr/sbin/update-ca-certificates >/dev/null 2>&1 || :
    elif sudo -n install -m 0644 "$PROXY_CA_CERT" "$anchor" 2>/dev/null; then
        sudo -n /usr/sbin/update-ca-certificates >/dev/null 2>&1 || :
    else
        log "could not install the proxy CA into the system store; GUI apps may not trust the proxy"
    fi
}

# PROXY is the other per-menu-entry setting that applies to every tool: it is
# exported both as G4F_PROXY, which g4f itself reads for its own requests, and
# as the conventional HTTP_PROXY/HTTPS_PROXY/ALL_PROXY variables, which the
# agents and the tools they shell out to honour. The typical value is the local
# "Install & Run Proxy Server" entry (mitmproxy on 127.0.0.1:8081). Loopback is
# added to NO_PROXY so the launchers can still reach the g4f API and the other
# local servers directly instead of looping back through the proxy.
apply_sandbox_proxy() {
    local proxy="${G4F_SANDBOX_PROXY:-${SANDBOX_PROXY:-${G4F_PROXY:-}}}"
    [ -n "$proxy" ] || return 0
    export G4F_PROXY="$proxy"
    export HTTP_PROXY="$proxy" HTTPS_PROXY="$proxy" ALL_PROXY="$proxy"
    export http_proxy="$proxy" https_proxy="$proxy" all_proxy="$proxy"
    local no_proxy="${NO_PROXY:-${no_proxy:-127.0.0.1,localhost,::1}}"
    export NO_PROXY="$no_proxy" no_proxy="$no_proxy"
    trust_proxy_ca
}

ensure_node() {
    have npm && return 0
    log "installing Node.js + npm (first run)..."
    as_root apt-get update -qq || die "apt-get update failed"
    as_root apt-get install -y -qq nodejs npm || die "could not install nodejs/npm"
    have npm || die "npm not found after installing nodejs/npm"
}

# Some vendor installers (Kiro CLI) unpack a .zip; the image ships zip but not
# unzip, so pull it in on demand.
ensure_unzip() {
    have unzip && return 0
    log "installing unzip (needed by the installer)..."
    as_root apt-get update -qq || die "apt-get update failed"
    as_root apt-get install -y -qq unzip || die "could not install unzip"
    have unzip || die "unzip not found after installing it"
}

# Hermes clones its own checkout, so it needs git; the image ships none.
ensure_git() {
    have git && return 0
    log "installing git (needed by the installer)..."
    as_root apt-get update -qq || die "apt-get update failed"
    as_root apt-get install -y -qq git || die "could not install git"
    have git || die "git not found after installing it"
}

ensure_npm() { # <npm package> <binary>
    have "$2" && return 0
    ensure_node
    log "installing $1 (npm install -g)..."
    as_root npm install -g --no-fund --no-audit "$1" || die "npm install $1 failed"
    have "$2" || die "$2 not on PATH after installing $1"
}

ensure_pip() { # <pypi package> <binary>
    have "$2" && return 0
    log "installing $1 (pip install --user)..."
    python3 -m pip install --user --quiet "$1" || die "pip install $1 failed"
    have "$2" || die "$2 not on PATH after installing $1"
}

ensure_apt_soft() { # <apt package> <binary>; returns 1 instead of exiting
    have "$2" && return 0
    log "installing $1 (apt)..."
    # --no-install-recommends keeps menu installs small: thunar's recommends
    # alone pull tumbler -> gdal/opencv and dbus-user-session/systemd, which
    # turns a file manager into a multi-minute, session-touching install.
    # DEBIAN_FRONTEND keeps a package with a conffile prompt from wedging the
    # terminal that the menu entry opened.
    as_root env DEBIAN_FRONTEND=noninteractive apt-get update -qq || return 1
    as_root env DEBIAN_FRONTEND=noninteractive \
        apt-get install -y -qq --no-install-recommends "$1" || return 1
    have "$2"
}

ensure_apt() { # <apt package> <binary>
    ensure_apt_soft "$1" "$2" || die "could not install $1"
}

# uv is the only Python toolchain here that can pick an interpreter version:
# the image's embedded CPython is 3.15, which is too new for SWE-agent, whose
# pinned dependencies ship no wheels for it. uv downloads a matching CPython
# on demand.
ensure_uv() {
    have uv && return 0
    log "installing uv (needed to pick a Python version)..."
    curl -fsSL "$UV_INSTALLER" | sh || die "uv install failed"
    have uv || die "uv not on PATH after installing it"
}

# SWE-agent ships its config/, tools/ and trajectories/ directories next to the
# package and asserts they exist at import time, but its wheel does not carry
# them -- a plain `uv tool install` of the git checkout installs a package that
# crashes on start. An editable install of a real clone keeps the repo layout,
# so the assertions hold.
ensure_sweagent() {
    have sweagent && return 0
    ensure_uv
    ensure_git
    local repo="$HOME/.swe-agent"
    if [ ! -d "$repo/.git" ]; then
        log "cloning SWE-agent into $repo..."
        rm -rf "$repo"
        git clone --depth 1 https://github.com/SWE-agent/SWE-agent.git "$repo" ||
            die "could not clone SWE-agent"
    fi
    log "installing SWE-agent (uv tool install --editable)..."
    uv tool install --force --editable --python 3.13 "$repo" ||
        die "uv tool install SWE-agent failed"
    have sweagent || die "sweagent not on PATH after installing it"
}

# The real Chrome binary, ignoring the ~/.local/bin wrapper installed below
# (which would otherwise make `command -v google-chrome` succeed on its own).
chrome_real_bin() {
    local p
    for p in /usr/bin/google-chrome-stable /usr/bin/google-chrome \
             /opt/google/chrome/google-chrome; do
        [ -x "$p" ] && { printf '%s\n' "$p"; return 0; }
    done
    return 1
}

# Chrome refuses to start its sandbox inside the container: Docker's default
# seccomp profile blocks the user namespaces its zygote needs, so it dies with
# "Failed to move to new namespace ... Operation not permitted" even as the
# unprivileged `pn` user. Put a wrapper named `google-chrome` in the user's bin
# that always passes --no-sandbox. ~/.local/bin comes first on PATH, so the
# shell, start-browser and g4f's own browser lookup all pick it up, while the
# real binary stays untouched.
link_chrome_no_sandbox() {
    local real bin
    real="$(chrome_real_bin)" || die "google-chrome not found after install"
    bin="$HOME/.local/bin/google-chrome"
    mkdir -p "$HOME/.local/bin" || die "cannot create $HOME/.local/bin"
    cat > "$bin" <<EOF
#!/bin/sh
# Generated by sandbox-cli: Chrome's sandbox cannot run in this container.
exec "$real" --no-sandbox "\$@"
EOF
    chmod 0755 "$bin" || die "cannot make $bin executable"
    ln -sf google-chrome "$HOME/.local/bin/google-chrome-stable"
    log "linked $bin -> $real (--no-sandbox)"
}

ensure_chrome() {
    if ! chrome_real_bin >/dev/null; then
        install_chrome_deb
    fi
    link_chrome_no_sandbox
}

install_chrome_deb() {
    local arch deb_url
    arch="$(dpkg --print-architecture || true)"
    case "$arch" in
        amd64) deb_url="${CHROME_DEB_BASE}_amd64.deb" ;;
        arm64) deb_url="${CHROME_DEB_BASE}_arm64.deb" ;;
        aarch64) deb_url="${CHROME_DEB_BASE}_arm64.deb" ;;
        *) deb_url="${CHROME_DEB_BASE}_amd64.deb" ;;
    esac
    log "installing Google Chrome (apt install of ${deb_url##*/}) on first run..."
    local tmp
    tmp="$(mktemp --suffix=.deb)" || die "cannot create temp file for Chrome .deb"
    curl -fsSL -o "$tmp" "$deb_url" || die "failed to download Google Chrome .deb"
    as_root apt-get -qq update || die "apt-get update failed"
    as_root apt-get install -y -qq "$tmp" || die "failed to install Google Chrome .deb"
    rm -f "$tmp"
    chrome_real_bin >/dev/null || die "google-chrome not found after installing the .deb"
}

ensure_lightpanda() {
    have g4f-go || die "g4f-go is not installed"
    g4f-go browser path >/dev/null 2>&1 && return 0
    log "installing Lightpanda (g4f-go browser install)..."
    g4f-go browser install || die "Lightpanda install failed"
    g4f-go browser path >/dev/null 2>&1 || die "Lightpanda not installed after g4f-go browser install"
}

# Remote Desktop is a bundled g4f-go module (`g4f-go -m remote_desktop`):
# g4f-go extracts it into its own runtime and pip-installs the extra packages
# it needs there on first use -- qrcode (the pairing QR SVG) and pynput
# (pointer and keyboard injection). Installing them here up front makes a
# failure visible in this terminal instead of leaving a server that silently
# has no QR code and no input control. `python3` is the embedded interpreter,
# so the probe looks at the same site-packages g4f-go does (PYTHONNOUSERSITE
# mirrors its runtime env).
#
# pynput's wheel metadata pulls in `evdev` on Linux, a C extension that needs
# kernel headers and a compiler the slim image does not carry, so a plain
# `pip install pynput` fails to build it. The sandbox session is X11, where
# pynput talks to the server through python-xlib instead of evdev, so pynput is
# installed without its dependencies and python-xlib is pulled explicitly.
ensure_remote_desktop() {
    have g4f-go || die "g4f-go is not installed"
    if have python3 && PYTHONNOUSERSITE=1 python3 -c \
        'import importlib.util, sys; sys.exit(0 if all(importlib.util.find_spec(m) for m in ("qrcode", "pynput", "Xlib")) else 1)' \
        2>/dev/null; then
        return 0
    fi
    log "installing Remote Desktop dependencies (qrcode, python-xlib, pynput)..."
    g4f-go install qrcode python-xlib || die "could not install qrcode/python-xlib"
    g4f-go install --no-deps pynput || die "could not install pynput"
}

ensure_script() { # <install script url> <binary> <label>
    have "$2" && return 0
    log "installing $3..."
    curl -fsSL "$1" | bash || die "$3 install script failed"
    have "$2" || die "$2 not on PATH after the $3 install"
}

# Roomote's installer is a host installer: it runs as root, installs Docker if
# it is missing, writes /opt/roomote and starts a Compose stack. The sandbox
# image has no init system, so the systemd unit it writes is inert here and the
# stack is started directly instead. `--tls-mode internal` keeps Caddy on a
# self-signed certificate, so the install needs no public DNS or ACME round
# trip; the printed /setup link is reachable through the sandbox's own URLs.
ensure_roomote() {
    have roomote && return 0
    log "installing Roomote (self-hosted coding agent)..."
    curl -fsSL "$ROOMOTE_INSTALLER" | as_root bash -s -- --tls-mode internal \
        || die "Roomote install script failed"
    have roomote || die "roomote not on PATH after the Roomote install"
}

# Hermes installs into ~/.hermes/hermes-agent/.hermes/bin and only adds
# ~/.local/bin to the shell rc, so link the binary there for the next run.
ensure_hermes() {
    have hermes && return 0
    ensure_git
    log "installing Hermes Agent (Nous Research)..."
    curl -fsSL "$HERMES_INSTALLER" | bash -s -- --non-interactive \
        || die "Hermes Agent install script failed"
    local bin="$HOME/.hermes/hermes-agent/.hermes/bin/hermes"
    if [ -x "$bin" ]; then
        mkdir -p "$HOME/.local/bin"
        ln -sf "$bin" "$HOME/.local/bin/hermes"
    fi
    have hermes || die "hermes not on PATH after the Hermes Agent install"
}

# Oh My Hermes (OMH) is an npm launcher around a Python wheel; it needs Hermes
# itself, which the omh case installs first. `omh setup --yes` is the
# non-interactive form documented upstream: it installs the managed skills and
# registers them with Hermes without asking the user-scope question.
ensure_omh() {
    have omh && return 0
    ensure_npm "$OMH_PACKAGE" omh
}

# Hugging Face's standalone installer builds a private venv and writes the hf
# wrapper into ~/.local/bin, which sandbox-cli already puts on PATH.
ensure_hf() {
    have hf && return 0
    log "installing the Hugging Face CLI (hf)..."
    curl -fsSL "$HF_CLI_INSTALLER" \
        | bash -s -- --exclude-skill --no-modify-path \
        || die "the Hugging Face CLI install script failed"
    have hf || die "hf not on PATH after the Hugging Face CLI install"
}

# The Skills CLI understands each agent's skill layout, so let it decide where
# Humanizer goes instead of copying SKILL.md into one guessed directory.
ensure_humanizer() {
    [ -f "$HOME/.agents/skills/humanizer/SKILL.md" ] && return 0
    have npx || ensure_node
    log "installing the Humanizer skill for the installed agents..."
    npx -y skills add "$HUMANIZER_SKILL" --global --agent '*' -y \
        || die "could not install the Humanizer skill"
    [ -f "$HOME/.agents/skills/humanizer/SKILL.md" ] \
        || die "Humanizer was not installed under ~/.agents/skills"
}

# Install a Python CLI from a git checkout. Used by the detectors: neither is
# published on PyPI, and both ship their entry point in pyproject.toml.
ensure_pip_git() { # <repository url> <binary> <label>
    have "$2" && return 0
    ensure_git
    log "installing $3 (pip install --user from git)..."
    python3 -m pip install --user --quiet "git+$1" \
        || die "pip install $3 failed"
    have "$2" || die "$2 not on PATH after installing $3"
}

# Oh My Pi (OMP) is the host that pi-freeflow plugs into. The installer fetches
# a prebuilt binary into $PI_INSTALL_DIR (default ~/.local/bin, already first on
# PATH), so the sandbox needs no Bun toolchain of its own.
ensure_omp() {
    have omp && return 0
    log "installing Oh My Pi (OMP)..."
    curl -fsSL "$OMP_INSTALLER" | bash || die "the OMP install script failed"
    have omp || die "omp not on PATH after the OMP install"
}

# Pi's installer manages its own runtime under ~/.pi/agent/bin and only tells
# the shell to prepend that directory, so link the binary into ~/.local/bin
# (already on PATH here) for the next click and for the menu entries.
ensure_pi() {
    have pi && return 0
    log "installing Pi..."
    curl -fsSL "$PI_INSTALLER" | sh || die "the Pi install script failed"
    local bin="$HOME/.pi/agent/bin/pi"
    if [ -x "$bin" ]; then
        mkdir -p "$HOME/.local/bin"
        ln -sf "$bin" "$HOME/.local/bin/pi"
    fi
    have pi || die "pi not on PATH after the Pi install"
}

# pi-freeflow is a Pi/OMP extension rather than a CLI. On OMP it is a plugin;
# `omp plugin list` is the cheap probe -- installing it again succeeds, but
# re-downloads the npm tarball on every click. Listing needs no network, so an
# offline click still starts OMP.
ensure_pi_freeflow_omp() {
    have omp || die "omp is not installed"
    omp plugin list 2>/dev/null | grep -q "$PI_FREEFLOW_PLUGIN" && return 0
    log "installing the pi-freeflow plugin (35 free models)..."
    omp plugin install "$PI_FREEFLOW_PLUGIN" \
        || die "omp plugin install $PI_FREEFLOW_PLUGIN failed"
}

# On Pi the same package is a user package: `pi install` adds it to settings
# and keeps the checkout under ~/.pi/agent. It accepts the npm source form the
# project documents, and a second run is a no-op ("up to date").
ensure_pi_freeflow_pi() {
    have pi || die "pi is not installed"
    pi list 2>/dev/null | grep -q "$PI_FREEFLOW_PLUGIN" && return 0
    log "installing the pi-freeflow package (35 free models)..."
    pi install "npm:$PI_FREEFLOW_PLUGIN" \
        || die "pi install npm:$PI_FREEFLOW_PLUGIN failed"
}

# Where the installed extension's sources live. OMP plugins and Pi packages
# both land in a node_modules tree (hence the copy below, see
# start_freeflow_api); either one is enough to run the shared daemon.
pi_freeflow_package_dir() {
    local dir
    for dir in \
        "$HOME/.omp/plugins/node_modules/$PI_FREEFLOW_PLUGIN" \
        "$HOME/.pi/agent/npm/node_modules/$PI_FREEFLOW_PLUGIN"; do
        [ -f "$dir/src/daemon.ts" ] && { printf '%s\n' "$dir"; return 0; }
    done
    return 1
}

# The API entry only needs the extension sources, not a full agent host: reuse
# an OMP plugin or Pi package when one is already installed, otherwise install
# the lighter Pi package (npm, no extra binary download).
ensure_freeflow_api() {
    pi_freeflow_package_dir >/dev/null && return 0
    ensure_pi
    ensure_pi_freeflow_pi
}

# Print what a client needs: the OpenAI-compatible base URL and the bearer
# token the daemon writes next to its other data files.
show_freeflow_access() {
    local token_file="$HOME/.pi/agent/token" token
    token="$(cat "$token_file" 2>/dev/null || true)"
    printf '\n  Base URL: http://127.0.0.1:%s/v1\n' "$FREEFLOW_PORT"
    printf '  API key:  %s\n' "${token:-(not written yet: $token_file)}"
    printf '  Models:   curl -s -H "Authorization: Bearer $(cat %s)" http://127.0.0.1:%s/v1/models\n\n' \
        "$token_file" "$FREEFLOW_PORT"
}

# Keep a daemon another session started alive: attach this shell as a client
# and refresh the lease every ten seconds (the daemon drops a lease after 30s).
# Ctrl-C stops the refresh, and the daemon retires on its normal grace window.
hold_freeflow_lease() {
    local token_file="$HOME/.pi/agent/token" token id
    id="sandbox-api-$$"
    log "holding the daemon open as a client (Ctrl-C to stop)"
    while :; do
        token="$(cat "$token_file" 2>/dev/null || true)"
        if [ -n "$token" ]; then
            curl -fsS --max-time 2 \
                -H "Authorization: Bearer $token" \
                -H 'content-type: application/json' \
                -d "{\"id\":\"$id\"}" \
                "http://127.0.0.1:$FREEFLOW_PORT/_client/attach" >/dev/null 2>&1 || true
        fi
        sleep 10
    done
}

# Run the extension's own detached-daemon entry in the foreground so its log
# stays readable (Ctrl-C stops it). Node refuses to type-strip files under a
# node_modules path, so the package is copied to a normal directory first;
# undici is the one runtime dependency and is linked from next to the source.
# The daemon otherwise retires ~10s after its last client session ends, so the
# lease-less grace window is stretched: this entry *is* the client of record.
start_freeflow_api() {
    local src dir token_file pid i
    src="$(pi_freeflow_package_dir)" \
        || die "pi-freeflow is not installed; run: sandbox-cli install pi-freeflow"
    dir="$HOME/.local/share/pi-freeflow-daemon"
    rm -rf "$dir"
    mkdir -p "$dir" || die "cannot create $dir"
    cp -a "$src/." "$dir/" || die "could not copy pi-freeflow to $dir"
    mkdir -p "$dir/node_modules"
    [ -d "$(dirname "$src")/undici" ] \
        || die "undici is missing next to $src; reinstall pi-freeflow"
    ln -sfn "$(dirname "$src")/undici" "$dir/node_modules/undici" \
        || die "could not link undici into $dir"

    token_file="$HOME/.pi/agent/token"
    log "starting the pi-freeflow API on http://127.0.0.1:$FREEFLOW_PORT (Ctrl-C to stop)"
    PI_FREEFLOW_DAEMON_GRACE_MS=31536000000 \
        node --experimental-strip-types "$dir/src/daemon.ts" &
    pid=$!
    for i in $(seq 1 40); do
        [ -s "$token_file" ] && break
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done
    if ! kill -0 "$pid" 2>/dev/null; then
        wait "$pid" 2>/dev/null || true
        die "the pi-freeflow daemon failed to start (see $HOME/.pi/agent/pi-freeflow.log)"
    fi
    show_freeflow_access
    wait "$pid"
}

# Ollama's installer needs a real init system or falls back to a manual start;
# it also wants `zstd` to unpack its payload, which the slim image lacks.
ensure_ollama() {
    have ollama && return 0
    have zstd || {
        log "installing zstd (needed by the Ollama installer)..."
        as_root apt-get update -qq || die "apt-get update failed"
        as_root apt-get install -y -qq zstd || die "could not install zstd"
    }
    log "installing Ollama..."
    curl -fsSL "$OLLAMA_INSTALLER" | sh || die "Ollama install script failed"
    have ollama || die "ollama not on PATH after the install"
}

# LM Studio's installer drops the `lms` CLI into ~/.lmstudio/bin (already on
# PATH above) and, on a machine without a desktop session, only the daemon.
ensure_lmstudio() {
    have lms && return 0
    log "installing LM Studio (lms CLI + daemon)..."
    curl -fsSL "$LMSTUDIO_INSTALLER" | sh || die "LM Studio install script failed"
    have lms || die "lms not on PATH after the LM Studio install"
}

# llama.cpp ships prebuilt tarballs per release build; the tag is resolved from
# the GitHub API so the entry does not pin a build that later disappears.
ensure_llamacpp() {
    have llama-server && return 0
    local arch tag url dir
    case "$(dpkg --print-architecture 2>/dev/null || echo amd64)" in
        arm64|aarch64) arch="arm64" ;;
        *) arch="x64" ;;
    esac
    tag="$(curl -fsSL "https://api.github.com/repos/ggml-org/llama.cpp/releases?per_page=1" \
        | grep -m1 '"tag_name"' | cut -d'"' -f4)"
    [ -n "$tag" ] || die "could not resolve the latest llama.cpp release"
    url="$LLAMACPP_RELEASE_BASE/$tag/llama-$tag-bin-ubuntu-$arch.tar.gz"
    log "installing llama.cpp ($tag, $arch)..."
    dir="$HOME/.llama.cpp"
    rm -rf "$dir"
    mkdir -p "$dir"
    curl -fsSL "$url" | tar -xz -C "$dir" --strip-components=1 \
        || die "could not download llama.cpp ($url)"
    mkdir -p "$HOME/.local/bin"
    ln -sf "$dir/llama-server" "$HOME/.local/bin/llama-server"
    ln -sf "$dir/llama-cli" "$HOME/.local/bin/llama-cli"
    have llama-server || die "llama-server not on PATH after the install"
}

# Jan is an Electron desktop app shipped as an AppImage; the tag is resolved
# from the GitHub API and the AppImage unpacked into ~/.local (no FUSE in the
# container, so it is extracted rather than mounted).
ensure_jan() {
    have jan && return 0
    local tag url dir
    tag="$(curl -fsSL "https://api.github.com/repos/janhq/jan/releases/latest" \
        | grep -m1 '"tag_name"' | cut -d'"' -f4)"
    [ -n "$tag" ] || die "could not resolve the latest Jan release"
    url="$JAN_RELEASE_BASE/$tag/Jan_${tag#v}_amd64.AppImage"
    log "installing Jan ($tag)..."
    dir="$HOME/.local/opt/jan"
    rm -rf "$dir"
    mkdir -p "$dir"
    curl -fsSL -o "$dir/jan.AppImage" "$url" || die "could not download Jan ($url)"
    chmod +x "$dir/jan.AppImage"
    ( cd "$dir" && ./jan.AppImage --appimage-extract >/dev/null 2>&1 ) \
        || die "could not unpack the Jan AppImage"
    mkdir -p "$HOME/.local/bin"
    ln -sf "$dir/squashfs-root/AppRun" "$HOME/.local/bin/jan"
    have jan || die "jan not on PATH after the install"
}

# Electron desktop apps (LobeChat, Msty Studio, Orca) link against NSS/NSPR,
# ALSA and X11 extensions, which the slim image does not carry. Chrome's .deb
# pulls the same libraries in, but these entries never install Chrome, so they
# are installed here on first click.
ensure_electron_libs() {
    have ldconfig || return 0
    if ldconfig -p 2>/dev/null | grep -q "libnss3.so" \
        && ldconfig -p 2>/dev/null | grep -q "libasound.so.2" \
        && ldconfig -p 2>/dev/null | grep -q "libxss.so.1" \
        && ldconfig -p 2>/dev/null | grep -q "libxtst.so.6"; then
        return 0
    fi
    log "installing the Electron runtime libraries (NSS, ALSA, X11)..."
    as_root apt-get update -qq || die "apt-get update failed"
    as_root apt-get install -y -qq libnss3 libnspr4 libasound2t64 \
        libxss1 libxtst6 \
        || die "could not install the Electron runtime libraries"
}

# Resolve the tag of a GitHub repository's latest release. Used by the
# AppImage entries, whose asset names embed the version in different ways.
latest_release_tag() { # <api url> <label>
    local tag
    tag="$(curl -fsSL "$1" | grep -m1 '"tag_name"' | cut -d'"' -f4)"
    [ -n "$tag" ] || die "could not resolve the latest $2 release"
    printf '%s\n' "$tag"
}

# Write a launcher for an unpacked AppImage. The wrapper pins APPDIR because
# some AppRuns mis-detect it, and adds --no-sandbox when the container cannot
# create unprivileged user namespaces (Electron ignores the flag elsewhere).
write_appimage_launcher() { # <opt dir name> <binary>
    local name="$1" bin="$2"
    mkdir -p "$HOME/.local/bin"
    cat > "$HOME/.local/bin/$bin" <<APPIMAGE
#!/bin/bash
# Generated by sandbox-cli: the $name AppImage is unpacked under ~/.local/opt
# because the container has no FUSE.
appdir="\$HOME/.local/opt/$name/squashfs-root"
export APPDIR="\$appdir"
no_sandbox=()
if ! unshare -Ur true 2>/dev/null; then
    no_sandbox=(--no-sandbox)
fi
exec "\$appdir/AppRun" "\${no_sandbox[@]}" "\$@"
APPIMAGE
    chmod 0755 "$HOME/.local/bin/$bin"
}

# Download an AppImage, unpack it into ~/.local/opt/<name> and install the
# launcher from write_appimage_launcher. Electron apps need NSS/NSPR and ALSA.
install_appimage() { # <label> <url> <opt dir name> <binary>
    local label="$1" url="$2" name="$3" bin="$4" dir
    ensure_electron_libs
    log "installing $label..."
    dir="$HOME/.local/opt/$name"
    rm -rf "$dir"
    mkdir -p "$dir"
    curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 15 \
        -o "$dir/$name.AppImage" "$url" \
        || die "could not download $label ($url)"
    chmod +x "$dir/$name.AppImage"
    ( cd "$dir" && "./$name.AppImage" --appimage-extract >/dev/null 2>&1 ) \
        || die "could not unpack the $label AppImage"
    write_appimage_launcher "$name" "$bin"
    have "$bin" || die "$bin not on PATH after installing $label"
}

# LobeChat (lobehub) ships an Electron desktop app as an AppImage. Like Jan it
# is unpacked rather than mounted (no FUSE in the container) and the AppRun is
# symlinked onto PATH. The release only carries an x64 AppImage.
ensure_lobechat() {
    have lobechat && return 0
    local tag url dir
    case "$(dpkg --print-architecture 2>/dev/null || echo amd64)" in
        amd64|x86_64) ;;
        *) die "LobeChat publishes no Linux AppImage for $(dpkg --print-architecture); only x64 is available" ;;
    esac
    ensure_electron_libs
    tag="$(curl -fsSL "https://api.github.com/repos/lobehub/lobehub/releases/latest" \
        | grep -m1 '"tag_name"' | cut -d'"' -f4)"
    [ -n "$tag" ] || die "could not resolve the latest LobeChat release"
    url="$LOBECHAT_RELEASE_BASE/$tag/LobeHub-${tag#v}.AppImage"
    log "installing LobeChat ($tag)..."
    dir="$HOME/.local/opt/lobechat"
    rm -rf "$dir"
    mkdir -p "$dir"
    curl -fsSL -o "$dir/lobechat.AppImage" "$url" \
        || die "could not download LobeChat ($url)"
    chmod +x "$dir/lobechat.AppImage"
    ( cd "$dir" && ./lobechat.AppImage --appimage-extract >/dev/null 2>&1 ) \
        || die "could not unpack the LobeChat AppImage"
    mkdir -p "$HOME/.local/bin"
    ln -sf "$dir/squashfs-root/AppRun" "$HOME/.local/bin/lobechat"
    have lobechat || die "lobechat not on PATH after the install"
}

# Msty Studio is the current Msty desktop app (the old msty.app download URLs
# are dead). It serves a stable "latest" AppImage URL, so no release lookup is
# needed; x64 only, like LobeChat.
ensure_msty() {
    have msty && return 0
    local dir
    case "$(dpkg --print-architecture 2>/dev/null || echo amd64)" in
        amd64|x86_64) ;;
        *) die "Msty Studio publishes no Linux AppImage for $(dpkg --print-architecture); only x64 is available" ;;
    esac
    ensure_electron_libs
    log "installing Msty Studio..."
    dir="$HOME/.local/opt/msty"
    rm -rf "$dir"
    mkdir -p "$dir"
    curl -fsSL -o "$dir/msty.AppImage" "$MSTY_APPIMAGE_URL" \
        || die "could not download Msty Studio ($MSTY_APPIMAGE_URL)"
    chmod +x "$dir/msty.AppImage"
    ( cd "$dir" && ./msty.AppImage --appimage-extract >/dev/null 2>&1 ) \
        || die "could not unpack the Msty Studio AppImage"
    mkdir -p "$HOME/.local/bin"
    # Msty's AppRun cannot be used directly: its APPDIR detection walks up the
    # tree looking for a file named after the first argument, so passing any
    # argument resolves APPDIR to an empty string and it then tries to exec
    # "/mstystudio". It also lacks the --no-sandbox fail-safe that LobeChat's
    # AppRun has, which is needed where unprivileged user namespaces are
    # unavailable (containers, hardened hosts).
    cat > "$HOME/.local/bin/msty" <<'MSTY_WRAPPER'
#!/bin/bash
appdir="$HOME/.local/opt/msty/squashfs-root"
export APPDIR="$appdir"
no_sandbox=()
if ! unshare -Ur true 2>/dev/null; then
    no_sandbox=(--no-sandbox)
fi
exec "$appdir/AppRun" "${no_sandbox[@]}" "$@"
MSTY_WRAPPER
    chmod +x "$HOME/.local/bin/msty"
    have msty || die "msty not on PATH after the install"
}

# OpenBot is a local-first multi-agent desktop workspace (Codex, Claude,
# Grok). Its AppImage per architecture embeds the version in the asset name.
ensure_openbot() {
    have openbot && return 0
    local tag arch
    tag="$(latest_release_tag "$OPENBOT_RELEASE_API" OpenBot)"
    case "$(dpkg --print-architecture 2>/dev/null || echo amd64)" in
        amd64|x86_64) arch=x86_64 ;;
        arm64|aarch64) arch=arm64 ;;
        *) die "OpenBot publishes no AppImage for $(dpkg --print-architecture)" ;;
    esac
    install_appimage OpenBot \
        "$OPENBOT_RELEASE_BASE/$tag/OpenBot-${tag#v}-$arch.AppImage" \
        openbot openbot
}

# Orca's AppRun needs Chromium's GPU process, which is not usable on the
# sandbox's virtual display: it exits with "GPU process isn't usable. Goodbye."
# shortly after the window opens. Keep Chromium on the documented software
# rendering path and disable the GPU/compositor, which also avoids the Intel
# i915 SIGBUS crash. Orca's Linux CLI is called orca-ide (GNOME's screen reader
# owns `orca`), so install both names; the menu keeps using `orca`.
write_orca_launcher() {
    mkdir -p "$HOME/.local/bin"
    cat > "$HOME/.local/bin/orca" <<'ORCA_WRAPPER'
#!/bin/bash
# Generated by sandbox-cli: the Orca AppImage is unpacked under ~/.local/opt
# because the container has no FUSE.
appdir="$HOME/.local/opt/orca/squashfs-root"
export APPDIR="$appdir"
export LIBGL_ALWAYS_SOFTWARE=1
no_sandbox=()
if ! unshare -Ur true 2>/dev/null; then
    no_sandbox=(--no-sandbox)
fi
exec "$appdir/AppRun" "${no_sandbox[@]}" \
    --disable-gpu --disable-gpu-compositing --disable-dev-shm-usage "$@"
ORCA_WRAPPER
    chmod 0755 "$HOME/.local/bin/orca"
    ln -sf orca "$HOME/.local/bin/orca-ide"
}

# Orca is an IDE for parallel agentic development, shipped as an Electron
# AppImage (x64 and arm64 have different asset names). The asset names are
# stable, so use the latest-download redirect rather than the rate-limited API.
ensure_orca() {
    local asset
    case "$(dpkg --print-architecture 2>/dev/null || echo amd64)" in
        amd64|x86_64) asset=orca-linux.AppImage ;;
        arm64|aarch64) asset=orca-linux-arm64.AppImage ;;
        *) die "Orca publishes no AppImage for $(dpkg --print-architecture)" ;;
    esac
    if [ ! -x "$HOME/.local/opt/orca/squashfs-root/AppRun" ]; then
        install_appimage Orca "$ORCA_LATEST_BASE/$asset" orca orca
    fi
    write_orca_launcher
    have orca || die "orca not on PATH after installing Orca"
}

# VoiceStudio is an Electron voice studio (TTS/voice cloning). It publishes a
# Linux AppImage for x64 only.
ensure_voicestudio() {
    have voicestudio && return 0
