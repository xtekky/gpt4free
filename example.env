# Rename this file to .env and copy it to your cookies directory
# Update the API_KEY and other variables as needed

G4F_API_KEY=
G4F_PROXY=
G4F_TIMEOUT=
G4F_STREAM_TIMEOUT=
G4F_BROWSER_PORT=
G4F_BROWSER_HOST=
# Path to a Lightpanda binary; defaults to <config dir>/browser/lightpanda
G4F_BROWSER_LIGHTPANDA_PATH=
# Workspace directory used by the MCP tools and the PA provider loader
# (default: ~/.g4f/workspace)
G4F_DIR=
# MCP server: force sandbox detection / safe mode / shell tool (auto-detected by default)
G4F_SANDBOX=
G4F_MCP_SAFE_MODE=
G4F_MCP_SHELL=

# Local OmniRoute gateway (default: http://localhost:20128/v1).
# The API also proxies /omniroute/* to this instance.
OMNIROUTE_BASE_URL=
OMNIROUTE_HOST=
OMNIROUTE_PORT=

# Local Ollama gateway (default: http://localhost:11434).
# OLLAMA_HOST may be a bare host or a full URL (Ollama convention).
# The API also proxies /ollama/* to this instance.
OLLAMA_BASE_URL=
OLLAMA_HOST=
OLLAMA_PORT=

HUGGINGFACE_API_KEY=
POLLINATIONS_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTERFREE_API_KEY=
ORCAROUTER_API_KEY=
CHEAPERINFERENCE_API_KEY=
APIROUTE_API_KEY=
OLLAMA_API_KEY=
NVIDIA_API_KEY=
PUTER_API_KEY=
