# Rename this file to .env and copy it to your cookies directory
# Update the API_KEY and other variables as needed

G4F_API_KEY=
G4F_PROXY=
G4F_TIMEOUT=
G4F_STREAM_TIMEOUT=
G4F_BROWSER_PORT=
G4F_BROWSER_HOST=
# Path to a Lightpanda binary; defaults to <config dir>/browser/lightpanda
G4F_BROWSER_LIGHTPANDA_PATH=
# Workspace directory used by the MCP tools and the PA provider loader
# (default: ~/.g4f/workspace)
G4F_DIR=
# MCP server: force sandbox detection / safe mode / shell tool (auto-detected by default)
G4F_SANDBOX=
G4F_MCP_SAFE_MODE=
G4F_MCP_SHELL=

# Local OmniRoute gateway (default: http://localhost:20128/v1).
# Reached through the API as the omniroute.g4f.local hostname (see below).
OMNIROUTE_BASE_URL=
OMNIROUTE_HOST=
OMNIROUTE_PORT=

# Host-based routing (sandbox): <app>.g4f.local and <port>.g4f.local reach the
# sandbox apps through the g4f API, e.g. omniroute.g4f.local or 20128.g4f.local.
# Set G4F_DOMAIN_ROUTER=0 to disable; G4F_DOMAIN_SUFFIX changes the suffix.
# An app that is not installed yet is installed and started on demand by
# sandbox-cli (the desktop menu's installer); set G4F_DOMAIN_AUTOSTART=0 to
# disable that and get the proxy's 502 "is not running" instead.
# The names resolve from /etc/hosts (or a wildcard resolver), not via mDNS
# multicast discovery (224.0.0.251 / ff02::fb); see the sandbox README.
G4F_DOMAIN_ROUTER=
G4F_DOMAIN_SUFFIX=
G4F_DOMAIN_AUTOSTART=

# Local Ollama gateway (default: http://localhost:11434).
# OLLAMA_HOST may be a bare host or a full URL (Ollama convention).
# Reached through the API as the ollama.g4f.local hostname (see above).
OLLAMA_BASE_URL=
OLLAMA_HOST=
OLLAMA_PORT=

HUGGINGFACE_API_KEY=
POLLINATIONS_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTERFREE_API_KEY=
ORCAROUTER_API_KEY=
CHEAPERINFERENCE_API_KEY=
APIROUTE_API_KEY=
OLLAMA_API_KEY=
NVIDIA_API_KEY=
PUTER_API_KEY=
