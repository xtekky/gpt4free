# Build stage
FROM python:3.15-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-slim.txt .
# --no-cache-dir avoids the pip wheel cache; the __pycache__/.pyc sweep keeps
# compiled bytecode that wheels occasionally ship out of the runtime layer.
RUN pip install --no-cache-dir --prefix=/install -r requirements-slim.txt && \
    find /install -type d -name '__pycache__' -prune -exec rm -rf {} + && \
    find /install -type f -name '*.pyc' -delete

# Final runtime stage
FROM python:3.15-slim-bookworm

ARG G4F_VERSION
ARG G4F_USER=g4f
ARG G4F_USER_ID=1000

ENV G4F_VERSION=$G4F_VERSION \
    G4F_USER=$G4F_USER \
    G4F_USER_ID=$G4F_USER_ID \
    G4F_DIR=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    flac \
    curl \
    && groupadd -g $G4F_USER_ID $G4F_USER \
    && useradd -rm -u $G4F_USER_ID -g $G4F_USER_ID $G4F_USER \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* /var/tmp/* \
              /usr/share/doc/* /usr/share/man/* /usr/share/info/*

# Copy pre-compiled dependencies from builder stage
COPY --from=builder /install /usr/local

WORKDIR $G4F_DIR

# Copy application source code
COPY --chown=$G4F_USER_ID:$G4F_USER_ID . $G4F_DIR

USER $G4F_USER_ID

EXPOSE 8080

CMD ["python", "-m", "g4f", "--port", "8080"]