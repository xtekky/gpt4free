[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open File Manager
Comment=Thunar file manager — installs on first click, then opens on the desktop
Exec=xfce4-terminal --disable-server --maximize --hide-borders --hide-menubar --title="File Manager" --icon=folder --command="/usr/local/bin/sandbox-cli files"
Icon=folder
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Files;
Keywords=files;file manager;thunar;browse;folders;;
StartupNotify=false
