[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open OpenHands
Comment=OpenHands coding agent — installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title=OpenHands --icon=g4f-sandbox-openhands --command="/usr/local/bin/sandbox-cli openhands"
Icon=g4f-sandbox-openhands
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Agent;
Keywords=openhands;opendevin;agent;ai;coding;;
StartupNotify=false
