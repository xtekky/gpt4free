[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open DeepTutor
Comment=DeepTutor personalized learning web app — installs on first click, then starts on port 3782
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title=DeepTutor --icon=g4f-sandbox-deeptutor --command="/usr/local/bin/sandbox-cli deeptutor"
Icon=g4f-sandbox-deeptutor
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Assistant;
Keywords=deeptutor;tutor;learning;rag;web;;
StartupNotify=false
