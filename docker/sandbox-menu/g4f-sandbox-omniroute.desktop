[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open OmniRoute
Comment=OmniRoute local AI gateway/router — installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title=OmniRoute --icon=g4f-sandbox-omniroute --command="/usr/local/bin/sandbox-cli omniroute"
Icon=g4f-sandbox-omniroute
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Gateway;
Keywords=omniroute;router;gateway;ai;llm;openai;;
StartupNotify=false
