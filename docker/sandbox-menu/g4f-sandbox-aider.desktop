[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open Aider
Comment=Aider pair-programming CLI — installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title=Aider --icon=g4f-sandbox-aider --command="/usr/local/bin/sandbox-cli aider"
Icon=g4f-sandbox-aider
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Agent;
Keywords=aider;ai;pair;programming;coding;;
StartupNotify=false
