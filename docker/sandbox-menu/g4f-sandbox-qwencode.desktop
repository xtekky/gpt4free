[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open Qwen
Comment=Qwen Code CLI — installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title=Qwen --icon=g4f-sandbox-qwencode --command="/usr/local/bin/sandbox-cli qwencode"
Icon=g4f-sandbox-qwencode
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Agent;
Keywords=qwen;qwencode;ai;agent;coding;;
StartupNotify=false
