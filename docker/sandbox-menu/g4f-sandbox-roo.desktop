[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open Roo Code
Comment=Roo Code CLI — installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title="Roo Code" --icon=g4f-sandbox-roo --command="/usr/local/bin/sandbox-cli roo"
Icon=g4f-sandbox-roo
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Agent;
Keywords=roo;roocode;agent;ai;coding;;
StartupNotify=false
