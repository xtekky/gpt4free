[Desktop Entry]
Version=1.0
Type=Application
Name=Host Names
Comment=Print the /etc/hosts entries the host needs for the *.g4f.local app domains
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title="Host Names" --icon=g4f-sandbox-cli --command="/usr/local/bin/sandbox-cli hosts"
Icon=g4f-sandbox-cli
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Core;
Keywords=g4f;hosts;hostnames;domains;dns;etc;hosts;;
StartupNotify=false