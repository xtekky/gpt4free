[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open Polli
Comment=Pollinations CLI — text, image, audio, video and 3D generation from the terminal; installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title=Polli --icon=g4f-sandbox-polli --command="/usr/local/bin/sandbox-cli polli"
Icon=g4f-sandbox-polli
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Media;
Keywords=pollinations;polli;media;image;video;audio;3d;generation;cli;;
StartupNotify=false
