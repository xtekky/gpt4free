[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open Amp
Comment=Amp by Sourcegraph — installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title=Amp --icon=g4f-sandbox-amp --command="/usr/local/bin/sandbox-cli amp"
Icon=g4f-sandbox-amp
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Agent;
Keywords=amp;sourcegraph;ai;agent;coding;;
StartupNotify=false
