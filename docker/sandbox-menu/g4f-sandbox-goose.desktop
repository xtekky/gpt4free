[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open Goose
Comment=Goose by Block — installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title=Goose --icon=g4f-sandbox-goose --command="/usr/local/bin/sandbox-cli goose"
Icon=g4f-sandbox-goose
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Agent;
Keywords=goose;block;ai;agent;coding;;
StartupNotify=false
