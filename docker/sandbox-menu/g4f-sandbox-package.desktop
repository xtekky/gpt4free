[Desktop Entry]
Version=1.0
Type=Application
Name=Update or Change g4f Package
Comment=Install the latest g4f release or pin a specific package version
Exec=xfce4-terminal --disable-server --maximize --hide-borders --hide-menubar --title="g4f Package" --icon=g4f-sandbox-cli --command="/usr/local/bin/sandbox-cli package"
Icon=g4f-sandbox-cli
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Core;
Keywords=g4f;package;update;upgrade;version;pin;pip;g4f-go;;
StartupNotify=false
