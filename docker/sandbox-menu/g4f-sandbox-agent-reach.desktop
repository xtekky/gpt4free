[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open Agent Reach
Comment=Agent Reach internet access for AI agents — installs on first click, then shows its channels in the terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title="Agent Reach" --icon=g4f-sandbox-agent-reach --command="/usr/local/bin/sandbox-cli agent-reach"
Icon=g4f-sandbox-agent-reach
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Assistant;
Keywords=agent-reach;search;browse;internet;skill;;
StartupNotify=false
