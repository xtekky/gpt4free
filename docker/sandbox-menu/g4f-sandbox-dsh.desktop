[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open DeepSeek Harness
Comment=DeepSeek Harness (dsh) coding agent — installs on first click, then opens in a terminal
Exec=xfce4-terminal --disable-server --maximize --hide-borders --hide-menubar --title="DeepSeek Harness" --icon=g4f-sandbox-dsh --command="/usr/local/bin/sandbox-cli dsh"
Icon=g4f-sandbox-dsh
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Agent;X-G4F-ChatUI;X-G4F-Assistant;
Keywords=dsh;deepseek;harness;agent;ai;coding;;
StartupNotify=false
