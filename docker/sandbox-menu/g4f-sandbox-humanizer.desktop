[Desktop Entry]
Version=1.0
Type=Application
Name=Install Humanizer
Comment=Humanizer agent skill — removes signs of AI-generated writing; installs for the sandbox's agents on first click
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title="Humanizer" --icon=g4f-sandbox-humanizer --command="/usr/local/bin/sandbox-cli humanizer"
Icon=g4f-sandbox-humanizer
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Writing;
Keywords=humanizer;anti-ai;ai-detection;writing;editing;skill;agent;;
StartupNotify=false
