[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open SWE-agent
Comment=SWE-agent by Princeton — installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title="SWE-agent" --icon=g4f-sandbox-sweagent --command="/usr/local/bin/sandbox-cli sweagent"
Icon=g4f-sandbox-sweagent
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Agent;
Keywords=sweagent;swe;agent;ai;coding;;
StartupNotify=false
