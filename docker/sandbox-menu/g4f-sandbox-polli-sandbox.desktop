[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open Polli Sandboxes
Comment=Create, connect to and manage hosted Polli (E2B) sandboxes; installs Polli + OpenSSH on first click
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title="Polli Sandboxes" --icon=g4f-sandbox-polli-sandbox --command="/usr/local/bin/sandbox-cli polli-sandbox"
Icon=g4f-sandbox-polli-sandbox
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Sandboxes;
Keywords=pollinations;polli;sandbox;e2b;ssh;vm;remote;cloud;;
StartupNotify=false
