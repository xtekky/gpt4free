[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open Continue
Comment=Continue CLI (cn) coding agent — installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title=Continue --command="/usr/local/bin/sandbox-cli continue-cli"
Icon=g4f-sandbox-cli
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Agent;
Keywords=continue;cn;agent;ai;coding;;
StartupNotify=false
