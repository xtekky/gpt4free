[Desktop Entry]
Version=1.0
Type=Application
Name=Install & Open Langfuse CLI
Comment=Langfuse LLM observability CLI — installs on first click, then opens in a terminal
Exec=xfce4-terminal --maximize --hide-borders --hide-menubar --title=Langfuse --icon=g4f-sandbox-langfuse --command="/usr/local/bin/sandbox-cli langfuse"
Icon=g4f-sandbox-langfuse
Terminal=false
Categories=X-G4F-Sandbox;X-G4F-Gateway;
Keywords=langfuse;observability;tracing;llm;gateway;;
StartupNotify=false
